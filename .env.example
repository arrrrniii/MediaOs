# ═══════════════════════════════════════
#  MediaOS Configuration
# ═══════════════════════════════════════

# ── PostgreSQL ──────────────────────
PG_DATABASE=mediaos
PG_USER=mediaos
PG_PASSWORD=changeme_pg_password
# Optional: connection-pool limits for the runtime app
# PG_POOL_MAX=20
# PG_POOL_IDLE_TIMEOUT_MS=30000
# PG_POOL_CONNECTION_TIMEOUT_MS=5000
# Optional: a separate privileged role used ONLY to run migrations (DDL),
# so the runtime PG_USER can be granted least privilege (no DDL). Falls back
# to PG_USER when unset.
# PG_MIGRATION_USER=mediaos_migrator
# PG_MIGRATION_PASSWORD=changeme_migrator_password

# ── MinIO ───────────────────────────
# Root credentials are used only by minio-setup to provision the bucket and the
# two least-privilege service accounts below. The worker and imgproxy use those
# service accounts, never root.
MINIO_ROOT_USER=mvadmin
MINIO_ROOT_PASSWORD=changeme_minio_password
MINIO_BUCKET=mediaos
# Worker: read/write on the bucket. imgproxy: read-only.
WORKER_MINIO_ACCESS_KEY=mediaos_worker
WORKER_MINIO_SECRET_KEY=changeme_worker_minio_secret
IMGPROXY_MINIO_ACCESS_KEY=mediaos_imgproxy
IMGPROXY_MINIO_SECRET_KEY=changeme_imgproxy_minio_secret

# ── Resource limits (optional; compose defaults shown) ──
# WORKER_MEM_LIMIT=2g
# WORKER_CPUS=2.0
# PG_MEM_LIMIT=1g
# MINIO_MEM_LIMIT=1g
# REDIS_MEM_LIMIT=512m
# IMGPROXY_MEM_LIMIT=512m
# DASHBOARD_MEM_LIMIT=512m

# ── Redis ───────────────────────────
REDIS_PASSWORD=changeme_redis_password

# ── API Worker ──────────────────────
API_PORT=3000
PUBLIC_URL=http://localhost:3000
NODE_ENV=production

# ── Observability ───────────────────
# LOG_LEVEL=info                 # debug | info | warn | error
# LOG_PRETTY=false               # human-readable logs in dev (default JSON)
# METRICS_PUBLIC=false           # true = /metrics needs no auth; else MASTER_KEY
# OTEL_EXPORTER_OTLP_ENDPOINT=   # set to enable OpenTelemetry tracing (e.g. http://otel-collector:4318)
# OTEL_SERVICE_NAME=mediaos-worker
# QUEUE_DEPTH_ALERT=1000         # warn when a queue exceeds this depth
# DISK_FREE_ALERT_PCT=10         # warn when free disk drops below this %
# ALERT_INTERVAL_MS=60000
# SHUTDOWN_TIMEOUT_MS=25000      # graceful-shutdown force-exit ceiling
# RESTORE_TEST_ENABLED=false     # scheduled archive->restore self-test
# LOG_RETENTION_MS=7776000000    # 90d — prune bandwidth/webhook/playback logs

# Master admin key — system administration only (creating/listing accounts).
# It does NOT authorize any customer-scoped route.
# Generate with: node -e "console.log('mv_master_' + require('crypto').randomBytes(24).toString('hex'))"
MASTER_KEY=mv_master_your_secret_here

# Shared secret between the dashboard server and the worker — REQUIRED for
# dashboard login and every account-scoped API call. Never exposed to browsers.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_SECRET=changeme_internal_api_secret

# Encrypts remote (cold) storage-backend credentials at rest in the database.
# A 32-byte key, hex or base64. Required only once you add an S3/R2/B2/remote-
# MinIO cold backend; the local MinIO default needs no key. Rotating it makes
# existing encrypted backend configs unreadable, so treat it as a durable secret.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STORAGE_ENCRYPTION_KEY=changeme_storage_encryption_key

# ── Initial Admin Account ─────────
# Created automatically on first boot if no accounts exist.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme_admin_password

# ── Image Processing ────────────────
WEBP_QUALITY=80
MAX_WIDTH=1600
MAX_HEIGHT=1600

# ── Video Processing ────────────────
VIDEO_CRF=20
VIDEO_MAX_HEIGHT=1080
CONCURRENCY=3

# ── Limits ──────────────────────────
MAX_FILE_SIZE=104857600   # 100MB

# ── Dashboard ───────────────────────
# Set COMPOSE_PROFILES=dashboard to enable the admin panel (enabled by default)
# Remove or leave empty to run API-only without the dashboard
COMPOSE_PROFILES=dashboard
DASHBOARD_PORT=3001
DASHBOARD_URL=http://localhost:3001
NEXTAUTH_SECRET=changeme_nextauth_secret
